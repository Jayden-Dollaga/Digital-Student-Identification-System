/* ---------------------------------------------------------
   Fingerprint Attendance — Qt Light Stylesheet
   Light theme providing a cleaner, brighter alternative to the default dark theme.
--------------------------------------------------------- */

* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: #1F2937;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F3F4F6;
}

QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #D1D5DB;
}

QLabel#sidebarTitle {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
}

QLabel#brandMark {
    background-color: #2563EB;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
}

QLabel#sidebarSubtitle {
    font-size: 11px;
    font-weight: 500;
    color: #6B7280;
    padding: 2px 2px 0 2px;
}

QFrame#sidebarDivider {
    background-color: #E5E7EB;
    border: none;
}

QPushButton#navButton {
    background-color: transparent;
    border: 1px solid transparent;
    text-align: left;
    padding: 10px 14px;
    border-radius: 10px;
    margin: 2px 2px;
    color: #4B5563;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #E5E7EB;
    color: #111827;
    border: 1px solid #D1D5DB;
}

QPushButton#navButton:checked {
    background-color: #DBEAFE;
    color: #1D4ED8;
    font-weight: 600;
    border-left: 3px solid #2563EB;
}

QLineEdit, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 10px;
    color: #111827;
}

QComboBox::drop-down {
    border: none;
}

QCheckBox {
    color: #4B5563;
}

QProgressBar {
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    text-align: center;
    background-color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 7px;
}

QWidget#headerBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D1D5DB;
}

QLabel#pageTitle {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
}

QLabel#connectionStatus {
    padding: 4px 10px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 12px;
}

QLabel#connectionStatus[state="connected"] {
    background-color: #DCFCE7;
    color: #166534;
}

QLabel#connectionStatus[state="disconnected"] {
    background-color: #FEE2E2;
    color: #991B1B;
}

QLabel#connectionStatus[state="connecting"] {
    background-color: #FEF3C7;
    color: #92400E;
}

QLabel#scanToast {
    padding: 10px 24px;
    font-weight: 600;
    font-size: 13px;
    border-bottom: 1px solid #D1D5DB;
}

QLabel#scanToast[kind="success"] {
    background-color: #DCFCE7;
    color: #166534;
}

QLabel#scanToast[kind="fail"] {
    background-color: #FEE2E2;
    color: #991B1B;
}

QLabel#scanToast[kind="duplicate"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
}

QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 12px;
}

QLabel#cardLabel {
    color: #6B7280;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

QLabel#cardValue {
    color: #111827;
    font-size: 26px;
    font-weight: 700;
}

QPushButton#primaryButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #3B82F6;
}

QPushButton#primaryButton:pressed {
    background-color: #1D4ED8;
}

QPushButton#dangerButton {
    background-color: #DC2626;
    color: #FEE2E2;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #B91C1C;
}

QPushButton#secondaryButton {
    background-color: #E5E7EB;
    color: #111827;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: #D1D5DB;
}

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
}

QHeaderView::section {
    background-color: #F3F4F6;
    color: #6B7280;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #D1D5DB;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #DBEAFE;
    color: #111827;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #9CA3AF;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #6B7280;
}

/* ---------------- Muted / secondary text ---------------- */
QLabel#mutedLabel {
    color: #6B7280;
}

/* ---------------- Warning banner ---------------- */
/* Same light-amber warning convention already used for
   connectionStatus[state="connecting"] below, so this reads as the same
   "heads up, not an error" tone as the rest of the light theme. */
QLabel#warningBanner {
    color: #92400E;
    background-color: #FEF3C7;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ---------------- Recent activity list (Dashboard) ---------------- */
QListWidget#recentActivityList {
    background-color: transparent;
    border: none;
}

QListWidget#recentActivityList::item {
    padding: 6px 2px;
    border-bottom: 1px solid #E5E7EB;
    color: #374151;
}

/* ---------------- Report preview (Reports page) ---------------- */
QPlainTextEdit#reportView {
    font-family: 'Consolas', 'Courier New', monospace;
}

/* ---------------- Dialogs & message boxes ---------------- */
/* Mirrors the dark theme's dialog/message-box block - see theme.qss for
   the full explanation. Without this, dialogs fell back to the native
   platform style instead of this light palette. */
QDialog {
    background-color: #F3F4F6;
}

QMessageBox {
    background-color: #FFFFFF;
}

QDialog QLabel,
QMessageBox QLabel {
    background-color: transparent;
    color: #1F2937;
}

QPushButton {
    background-color: #E5E7EB;
    color: #111827;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    min-width: 72px;
}

QPushButton:hover {
    background-color: #D1D5DB;
}

QPushButton:pressed {
    background-color: #C7CBD1;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* ---------------- Backups list (Reports page) ---------------- */
QListWidget#backupsList {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    color: #6B7280;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
}

QListWidget#backupsList::item {
    padding: 3px 8px;
}
